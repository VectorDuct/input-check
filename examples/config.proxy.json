{
  "listen": "127.0.0.1:9090",
  "mode": "inspect",
  "upstream": "https://api.example.com",
  "gateway_token_env": "INPUTCHECK_TOKEN",
  "upstream_token_env": "INPUTCHECK_UPSTREAM_TOKEN",
  "models": {"chat-a": "vendor-chat-a"},
  "tags": ["input", "user_input", "context", "content", "用户输入"],
  "reject_warnings": true,
  "max_input_bytes": 1048576,
  "max_output_bytes": 8388608,
  "max_concurrent": 2,
  "timeout_seconds": 60,
  "shutdown_seconds": 90
}
